            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run llama-bench (SECDA-nosim-x64)",
            "type": "shell",
            "command": "${workspaceFolder}/out/build/SECDA-nosim-x64/bin/llama-bench -m ${workspaceFolder}/llama.cpp/models/secda_models/Cryptography_GPT_2_v1.0.0.Q2_K.gguf -n 1 -t 1 -p 2",
            "options": {
                "cwd": "${workspaceFolder}/llama.cpp"

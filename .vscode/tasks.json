{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure SECDA-nosim-x64",
            "type": "shell",
            "command": "cmake --preset SECDA-nosim-x64",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build llama-cli (SECDA-nosim-x64)",
            "type": "shell",
            "command": "cmake --build --preset SECDA-nosim-x64 --target llama-cli -j",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Configure SECDA-nosim-x64",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build llama-bench (SECDA-nosim-x64)",

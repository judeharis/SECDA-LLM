{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) llama-cli (SECDA-nosim-x64)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Build llama-cli (SECDA-nosim-x64)",
            "program": "${workspaceFolder}/out/build/SECDA-nosim-x64/bin/llama-cli",
            "args": [
                "-m",
                "./models/secda_models/Cryptography_GPT_2_v1.0.0.Q2_K.gguf",
                // "./models/secda_models/LFM2.5-230M-Q3_K_S.gguf",
                "--single-turn",
                "-n",
                "10",
                "-t",
                "1",
                "-tb",
                "1",
                "--no-warmup",
                "--temp",
                "0",
                "-s",
                "1712523969",
                "-p",
                "what is my name?"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/llama.cpp",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${env:PATH}:${workspaceFolder}/out/build/SECDA-nosim-x64/bin"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },

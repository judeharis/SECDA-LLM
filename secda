#!/usr/bin/env python3
"""Top-level entry point for SECDA-Core's dev workflow -- see
third_party/secda_core/tools/secda_cli.py for the actual implementation.
Run with no arguments for an interactive menu, or `./secda <subcommand> ...`.
"""
import os
import sys

here = os.path.dirname(os.path.abspath(__file__))
target = os.path.join(here, "third_party", "secda_core", "tools", "secda_cli.py")
os.execv(sys.executable, [sys.executable, target] + sys.argv[1:])
